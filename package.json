{
  "name": "brainadz-projects",
  "version": "1.0.0",
  "private": true,
  "description": "BrainADZ Projects: project management for the Live, Marketing and Exhibits verticals.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "npm install && npm run build",
    "dev": "concurrently -k -n api,client \"npm run dev:api\" \"npm run dev:client\"",
    "dev:api": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning --watch backend/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "format": "prettier --write \"backend/**/*.{js,json,md}\" \"client/**/*.{js,jsx,css,json,html,webmanifest}\" \"tests/**/*.{js,jsx}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"backend/**/*.{js,json,md}\" \"client/**/*.{js,jsx,css,json,html,webmanifest}\" \"tests/**/*.{js,jsx}\" \"*.{js,json,md}\"",
    "lint": "eslint backend client/src client/public/sw.js tests eslint.config.js",
    "start": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning backend/index.js",
    "db:migrate": "node --env-file=.env --no-warnings=ExperimentalWarning backend/schema/migrate-sqlite-to-postgres.js",
    "seed:demo": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning backend/seeds/seed-demo.js",
    "test": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning --test tests/*.test.js",
    "seed:marketing": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning backend/seeds/seed-marketing-demo.js",
    "seed:website": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning backend/seeds/seed-website-demo.js",
    "seed:seo": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning backend/seeds/seed-seo-demo.js"
  },
  "dependencies": {
    "express": "4.22.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "9.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lucide-react": "0.468.0",
    "prettier": "^3.9.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "^8.3.5"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
