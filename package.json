{
  "name": "brainadz-projects",
  "version": "1.0.0",
  "private": true,
  "description": "BrainADZ Projects: project management for the Live, Marketing and Exhibits verticals.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "npm install && npm run build",
    "dev": "concurrently -k -n api,client \"npm run dev:api\" \"npm run dev:client\"",
    "dev:api": "node --no-warnings=ExperimentalWarning --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "build:demo": "vite build --config client/vite.config.js --mode demo && node scripts/build-artifact.js",
    "build:pages": "npm run build:demo && node scripts/build-pages.js",
    "start": "node --no-warnings=ExperimentalWarning server/index.js",
    "seed:demo": "node --no-warnings=ExperimentalWarning server/seed-demo.js",
    "test": "node --no-warnings=ExperimentalWarning --test tests/*.test.js",
    "seed:marketing": "node --no-warnings=ExperimentalWarning server/seed-marketing-demo.js",
    "seed:website": "node --no-warnings=ExperimentalWarning server/seed-website-demo.js"
  },
  "dependencies": {
    "express": "4.22.3",
    "multer": "2.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sql.js": "1.12.0",
    "vite": "5.4.21"
  }
}
